# ==========================================
# PlateVision Environment Variables
# ==========================================

# Backend Configuration
ENVIRONMENT=development
DEBUG=false
DETECTOR_BACKEND=auto
ONNX_MODEL_PATH=models/plate_detector.onnx
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DETECTION_CONFIDENCE_THRESHOLD=0.25
NMS_IOU_THRESHOLD=0.45
BBOX_PADDING_RATIO=0.06
MAX_IMAGE_SIZE_MB=10
TEMP_CROP_TTL_SECONDS=300
ENABLE_REDACTED_LOGS=true

# Frontend Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ==========================================
# Drishti Grid — city-wide multi-camera ANPR trajectory tracking
# ==========================================
GRID_ENABLED=true
# SQLite by default; use postgresql+psycopg://... for PostgreSQL/PostGIS
GRID_DATABASE_URL=sqlite:///./drishti_grid.db

# Role-based access control API keys (X-API-Key header).
# Unset keys fall back to a masked read-only viewer role.
DRISHTI_ADMIN_KEY=
DRISHTI_OPERATOR_KEY=
DRISHTI_VIEWER_KEY=

# Processing pipeline backends
VEHICLE_DETECTOR_BACKEND=hybrid
REID_BACKEND=auto

# Cross-camera fusion weights  S = lp*plate + lv*cos - lt*|dt - t_G|/sigma_t
FUSION_LAMBDA_PLATE=0.50
FUSION_LAMBDA_VISUAL=0.35
FUSION_LAMBDA_TIME=0.15
FUSION_SIGMA_T_SECONDS=180.0
# Confidence gate / abstention
FUSION_TAU=0.70
FUSION_DELTA=0.15
# plate_only | plate_visual | full
FUSION_MODE=full

# Road-network travel-time fallback (approximation when no router is available)
ROAD_FALLBACK_SPEED_KMH=34.0
ROAD_FALLBACK_DETOUR_FACTOR=1.35

# Event stream: memory (in-process) | kafka
EVENT_BACKEND=memory
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SIGHTINGS=drishti.sightings

# Demo / synthetic corridor mode
GRID_DEMO_MODE=true

# Privacy
PLATE_MASK_FOR_VIEWER=true
ENABLE_AUDIT_LOG=true
