DETECTOR_MODE=onnx
MODEL_PATH=../models/plate-detector.onnx
VEHICLE_MODEL_PATH=../models/vehicle-detector.onnx
ONNX_PROVIDER=CPUExecutionProvider
INFERENCE_THREADS=4
INPUT_SIZE=640
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080


VEHICLE_CONTEXT_ENABLED=false
PLATE_TILE_SIZE=480
PLATE_TILE_OVERLAP=0.25
CONFIDENCE_THRESHOLD=0.25
UNVERIFIED_PLATE_THRESHOLD=0.55
PLATE_CROP_PADDING=0.25
PLATE_REFINEMENT_ENABLED=true
MAX_PLATE_REFINEMENTS=12

# Auto uses OpenVINO GPU when available, otherwise ONNX CPU.
ACCELERATION=auto
OPENVINO_DEVICE=GPU
VIDEO_MAX_UPLOAD_MB=512
VIDEO_MAX_SECONDS=900
VIDEO_RESULT_TTL_SECONDS=3600
